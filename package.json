{
  "name": "inspecto",
  "version": "1.4.0",
  "description": "See what your Claude Code sessions cost, what keeps going wrong, and what to fix. Reads local logs, uploads nothing.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "inspecto": "dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "keywords": [
    "claude-code",
    "claude",
    "anthropic",
    "cost",
    "token-usage",
    "session-analysis",
    "cache-hit-rate",
    "claude-md",
    "developer-tools",
    "cli"
  ],
  "author": "Rahul Bhardwaj",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "files": [
    "dist",
    "PRIVACY.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rahulbhardwaj94/inspecto.git"
  },
  "bugs": {
    "url": "https://github.com/rahulbhardwaj94/inspecto/issues"
  },
  "homepage": "https://github.com/rahulbhardwaj94/inspecto#readme"
}
